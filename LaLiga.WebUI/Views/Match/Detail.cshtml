@model MatchDetailPageViewModel
@{
    var m = Model.Match;
    var homeXl = Model.HomeCrest("team-crest--xl");
    var awayXl = Model.AwayCrest("team-crest--xl");
    var homeXs = Model.HomeCrest("team-crest--xs");
    var awayXs = Model.AwayCrest("team-crest--xs");

    ViewData["Title"] = Model.PageTitle;
    ViewData["BodyClass"] = "match-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/match-detail.css" asp-append-version="true" />
}

<!-- SVG sembolleri (tekrar kullanılan ikonlar) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-ball" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor" /><path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6" fill="none" stroke="currentColor" stroke-width="1.4" /></symbol>
    <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
    <symbol id="i-stadium" viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8" /></symbol>
    <symbol id="i-whistle" viewBox="0 0 24 24"><circle cx="9" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12.5 10.5L21 6v4l-5.5 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></symbol>
</svg>

<main class="match-shell container-xl" data-match>

    <!--  _MatchHero  -->
    <header class="match-hero">
        <div class="hero-topbar">
            <ul class="comp-tags" aria-label="Müsabaka">
                <li class="comp-tag comp-tag--league">@Model.LeagueName</li>
                <li class="comp-tag">@Model.Season</li>
                <li class="comp-tag">Hafta @m.Week</li>
            </ul>
            <span class="status-pill">@Model.StatusText</span>
        </div>

        <div class="scoreboard">
            <div class="sb-team sb-team--home @(Model.HomeLost ? "is-loser" : "")">
                <partial name="_TeamCrest" model="homeXl" />
                <div>
                    <span class="sb-team__role">Ev sahibi</span>
                    <h1 class="sb-team__name">@m.HomeTeamName</h1>
                    @if (Model.HomeGoals.Count > 0)
                    {
                        <ul class="sb-scorers" aria-label="@m.HomeTeamName golleri">
                            @foreach (var g in Model.HomeGoals)
                            {
                                <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>@g.PlayerName @Model.MinuteLabel(g.Minute)</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="sb-score">
                @if (Model.ShowsScore)
                {
                    <p class="sb-score__value" aria-label="Skor: @m.HomeTeamName @m.HomeScore, @m.AwayTeamName @m.AwayScore">
                        <span class="@(Model.HomeLost ? "is-loser" : "")">@m.HomeScore</span><span class="sb-score__sep" aria-hidden="true"></span><span class="@(Model.AwayLost ? "is-loser" : "")">@m.AwayScore</span>
                    </p>
                }
                else
                {
                    <p class="sb-score__value" aria-label="Maç henüz oynanmadı"><span>-</span></p>
                }

                @if (Model.ShowsHalfTime)
                {
                    <p class="sb-score__ht">İlk yarı @Model.HalfTimeText</p>
                }
            </div>

            <div class="sb-team sb-team--away @(Model.AwayLost ? "is-loser" : "")">
                <partial name="_TeamCrest" model="awayXl" />
                <div>
                    <span class="sb-team__role">Deplasman</span>
                    <h2 class="sb-team__name">@m.AwayTeamName</h2>
                    @if (Model.AwayGoals.Count > 0)
                    {
                        <ul class="sb-scorers" aria-label="@m.AwayTeamName golleri">
                            @foreach (var g in Model.AwayGoals)
                            {
                                <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>@g.PlayerName @Model.MinuteLabel(g.Minute)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <ul class="hero-facts">
            <li><svg aria-hidden="true"><use href="#i-calendar" /></svg>@Model.DateText</li>
            <li><svg aria-hidden="true"><use href="#i-clock" /></svg>@Model.TimeText</li>
            <li><svg aria-hidden="true"><use href="#i-stadium" /></svg>@m.Stadium</li>
            @if (Model.HasReferee)
            {
                <li><svg aria-hidden="true"><use href="#i-whistle" /></svg><span>Hakem:</span> @m.Referee</li>
            }
        </ul>

        <!--  _MatchFlowStrip  -->
        @if (Model.Events.Count > 0)
        {
            <section class="flow-strip" aria-labelledby="flow-title">
                <div class="flow-head">
                    <h2 class="flow-title" id="flow-title">Maç akışı</h2>
                    <p class="flow-hint">Ayrıntısını görmek için bir olaya dokun</p>
                </div>
                <div class="flow-scroll">
                    <div class="flow-track">
                        <span class="flow-side-label flow-side-label--home"><partial name="_TeamCrest" model="homeXs" /></span>
                        <span class="flow-side-label flow-side-label--away"><partial name="_TeamCrest" model="awayXs" /></span>
                        <span class="flow-axis" aria-hidden="true"></span>
                        <span class="flow-half" aria-hidden="true"><span>Devre arası</span></span>

                        @foreach (var tick in new[] { 15, 30, 45, 60, 75, 90 })
                        {
                            <span class="flow-tick" style="--x:calc(@tick / 95 * 100%)">@tick'</span>
                        }

                        @foreach (var e in Model.Events)
                        {
                            <button type="button" class="flow-marker flow-marker--@e.Side flow-marker--@e.Kind" style="@Model.FlowStyle(e)" data-flow-ref="@e.DomId" aria-label="@e.AriaLabel" title="@e.Title">
                                <span class="flow-marker__dot">
                                    @if (e.Kind == "goal")
                                    {
                                        <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                                    }
                                    else if (e.Kind == "card")
                                    {
                                        <span class="i-card i-card--@e.Variant"></span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </div>
            </section>
        }
    </header>

    <div class="match-body">
        <div class="row g-4">

            <!-- ===== Sol kolon ===== -->
            <div class="col-lg-8">

                <!--  _MatchTimeline  -->
                <section class="panel" aria-labelledby="timeline-title">
                    <div class="panel__head">
                        <h2 class="panel__title" id="timeline-title">Maç olayları</h2>
                        @if (Model.Events.Count > 0)
                        {
                            <div class="event-filter" role="group" aria-label="Olay türüne göre filtrele">
                                <button type="button" class="chip" data-event-filter="all" aria-pressed="true">Tümü</button>
                                <button type="button" class="chip" data-event-filter="goal" aria-pressed="false">Goller</button>
                                <button type="button" class="chip" data-event-filter="card" aria-pressed="false">Kartlar</button>
                                <button type="button" class="chip" data-event-filter="sub" aria-pressed="false">Değişiklikler</button>
                            </div>
                        }
                    </div>

                    @if (Model.Events.Count == 0)
                    {
                        <div class="panel__body"><p class="item-empty">Bu maç için henüz olay kaydı girilmedi.</p></div>
                    }
                    else
                    {
                        var halfTimeShown = false;

                        <div class="timeline-legend" aria-hidden="true">
                            <span><partial name="_TeamCrest" model="homeXs" />@m.HomeTeamName</span>
                            <span></span>
                            <span>@m.AwayTeamName<partial name="_TeamCrest" model="awayXs" /></span>
                        </div>

                        <ol class="timeline">
                            <li class="event event--period"><span class="period-mark">Başlama düdüğü</span></li>

                            @foreach (var e in Model.Events)
                            {
                                if (Model.ShowsHalfTime && !halfTimeShown && e.Minute > 45)
                                {
                                    halfTimeShown = true;
                                    <li class="event event--period"><span class="period-mark">Devre arası <strong>@Model.HalfTimeText</strong></span></li>
                                }

                                <li class="event event--@e.Side event--@e.Variant" id="@e.DomId" data-type="@e.Kind">
                                    <span class="event__minute">@Model.MinuteLabel(e.Minute)</span>
                                    <div class="event-card">
                                        <span class="event-card__icon">
                                            @if (e.Kind == "goal")
                                            {
                                                <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                                            }
                                            else if (e.Kind == "card")
                                            {
                                                <span class="i-card i-card--@e.Variant"></span>
                                            }
                                            else
                                            {
                                                <svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg>
                                            }
                                        </span>
                                        <span class="event-card__body">
                                            @if (e.Kind == "sub")
                                            {
                                                <span class="event-card__player sub-in">@e.Player</span>
                                                <span class="event-card__meta sub-out">@e.Meta</span>
                                            }
                                            else
                                            {
                                                <span class="event-card__player">@e.Player</span>
                                                <span class="event-card__meta">@e.Meta</span>
                                            }
                                        </span>
                                        @if (e.Score != null)
                                        {
                                            <span class="event-score">@e.Score</span>
                                        }
                                    </div>
                                </li>
                            }

                            @if (Model.ShowsHalfTime && !halfTimeShown)
                            {
                                <li class="event event--period"><span class="period-mark">Devre arası <strong>@Model.HalfTimeText</strong></span></li>
                            }

                            @if (Model.IsFinished)
                            {
                                <li class="event event--period"><span class="period-mark">Maç sonu <strong>@m.HomeScore-@m.AwayScore</strong></span></li>
                            }
                        </ol>
                    }
                </section>

                <!--  _GoalsPanel  -->
                @if (m.Goals.Count > 0)
                {
                    <section class="panel" aria-labelledby="goals-title">
                        <div class="panel__head"><h2 class="panel__title" id="goals-title">Goller</h2></div>
                        <div class="split">
                            <div class="split__col">
                                <h3 class="split__team"><partial name="_TeamCrest" model="homeXs" />@m.HomeTeamName<span class="split__count">@Model.HomeGoals.Count gol</span></h3>
                                <ul class="item-list goal-list">
                                    @foreach (var g in Model.HomeGoals)
                                    {
                                        <li>
                                            <span class="item-minute">@Model.MinuteLabel(g.Minute)</span>
                                            <span class="item-main">
                                                <strong>@g.PlayerName</strong>
                                                @if (!string.IsNullOrWhiteSpace(g.AssistPlayerName))
                                                {
                                                    <small>Asist: @g.AssistPlayerName</small>
                                                }
                                            </span>
                                        </li>
                                    }
                                    @if (Model.HomeGoals.Count == 0)
                                    {
                                        <li class="item-empty">Gol yok</li>
                                    }
                                </ul>
                            </div>
                            <div class="split__col">
                                <h3 class="split__team"><partial name="_TeamCrest" model="awayXs" />@m.AwayTeamName<span class="split__count">@Model.AwayGoals.Count gol</span></h3>
                                <ul class="item-list goal-list">
                                    @foreach (var g in Model.AwayGoals)
                                    {
                                        <li>
                                            <span class="item-minute">@Model.MinuteLabel(g.Minute)</span>
                                            <span class="item-main">
                                                <strong>@g.PlayerName</strong>
                                                @if (!string.IsNullOrWhiteSpace(g.AssistPlayerName))
                                                {
                                                    <small>Asist: @g.AssistPlayerName</small>
                                                }
                                            </span>
                                        </li>
                                    }
                                    @if (Model.AwayGoals.Count == 0)
                                    {
                                        <li class="item-empty">Gol yok</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </section>
                }

                <!--  _CardsPanel  -->
                @if (m.Cards.Count > 0)
                {
                    <section class="panel" aria-labelledby="cards-title">
                        <div class="panel__head"><h2 class="panel__title" id="cards-title">Kartlar</h2></div>
                        <div class="split">
                            <div class="split__col">
                                <h3 class="split__team"><partial name="_TeamCrest" model="homeXs" />@m.HomeTeamName<span class="split__count">@Model.HomeCards.Count kart</span></h3>
                                <ul class="item-list">
                                    @foreach (var c in Model.HomeCards)
                                    {
                                        <li>
                                            <span class="item-minute">@Model.MinuteLabel(c.Minute)</span>
                                            <span class="item-main"><strong>@c.PlayerName</strong></span>
                                            <span class="card-tag"><span class="i-card i-card--@Model.CardVariant(c)"></span>@Model.CardShortText(c)</span>
                                        </li>
                                    }
                                    @if (Model.HomeCards.Count == 0)
                                    {
                                        <li class="item-empty">Kart yok</li>
                                    }
                                </ul>
                            </div>
                            <div class="split__col">
                                <h3 class="split__team"><partial name="_TeamCrest" model="awayXs" />@m.AwayTeamName<span class="split__count">@Model.AwayCards.Count kart</span></h3>
                                <ul class="item-list">
                                    @foreach (var c in Model.AwayCards)
                                    {
                                        <li>
                                            <span class="item-minute">@Model.MinuteLabel(c.Minute)</span>
                                            <span class="item-main"><strong>@c.PlayerName</strong></span>
                                            <span class="card-tag"><span class="i-card i-card--@Model.CardVariant(c)"></span>@Model.CardShortText(c)</span>
                                        </li>
                                    }
                                    @if (Model.AwayCards.Count == 0)
                                    {
                                        <li class="item-empty">Kart yok</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </section>
                }

                <!--  _SubstitutionsPanel  -->
                @if (m.Substitutions.Count > 0)
                {
                    <section class="panel" aria-labelledby="subs-title">
                        <div class="panel__head"><h2 class="panel__title" id="subs-title">Oyuncu değişiklikleri</h2></div>
                        <div class="split">
                            <div class="split__col">
                                <h3 class="split__team"><partial name="_TeamCrest" model="homeXs" />@m.HomeTeamName<span class="split__count">@Model.HomeSubstitutions.Count değişiklik</span></h3>
                                <ul class="item-list">
                                    @foreach (var s in Model.HomeSubstitutions)
                                    {
                                        <li>
                                            <span class="item-minute">@Model.MinuteLabel(s.Minute)</span>
                                            <span class="item-main"><strong class="sub-in">@s.PlayerIn</strong><small class="sub-out">@s.PlayerOut</small></span>
                                        </li>
                                    }
                                    @if (Model.HomeSubstitutions.Count == 0)
                                    {
                                        <li class="item-empty">Değişiklik yok</li>
                                    }
                                </ul>
                            </div>
                            <div class="split__col">
                                <h3 class="split__team"><partial name="_TeamCrest" model="awayXs" />@m.AwayTeamName<span class="split__count">@Model.AwaySubstitutions.Count değişiklik</span></h3>
                                <ul class="item-list">
                                    @foreach (var s in Model.AwaySubstitutions)
                                    {
                                        <li>
                                            <span class="item-minute">@Model.MinuteLabel(s.Minute)</span>
                                            <span class="item-main"><strong class="sub-in">@s.PlayerIn</strong><small class="sub-out">@s.PlayerOut</small></span>
                                        </li>
                                    }
                                    @if (Model.AwaySubstitutions.Count == 0)
                                    {
                                        <li class="item-empty">Değişiklik yok</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </section>
                }
            </div>

            <!-- ===== Sağ kolon ===== -->
            <aside class="col-lg-4 side-col" aria-label="Maç özeti ve istatistikler">

                <!--  _PeriodScoreCards  -->
                @if (Model.PeriodCards.Count > 0)
                {
                    <div class="period-cards">
                        @foreach (var card in Model.PeriodCards)
                        {
                            <article class="period-card @(card.IsFinal ? "period-card--final" : "")">
                                <p class="period-card__label">@card.Label</p>
                                <p class="period-card__score">@card.Score</p>
                                <p class="period-card__note">@card.Note</p>
                            </article>
                        }
                    </div>
                }

                <!--  _MatchStats  -->
                @if (m.Statistic is { } stat)
                {
                    <section class="panel" aria-labelledby="stats-title">
                        <div class="panel__head">
                            <h2 class="panel__title" id="stats-title">İstatistikler</h2>
                            <div class="stats-teams" aria-hidden="true">
                                <span><partial name="_TeamCrest" model="homeXs" />@m.HomeTeamName</span>
                                <span>@m.AwayTeamName<partial name="_TeamCrest" model="awayXs" /></span>
                            </div>
                        </div>

                        <div class="possession">
                            <div class="possession__row">
                                <span class="possession__value">@Model.PercentText(stat.HomePossession)</span>
                                <span class="possession__label">Topa sahip olma</span>
                                <span class="possession__value possession__value--away">@Model.PercentText(stat.AwayPossession)</span>
                            </div>
                            <div class="possession__bar" aria-hidden="true">
                                <span style="flex:@stat.HomePossession;background:var(--home)"></span>
                                <span style="flex:@stat.AwayPossession;background:var(--away)"></span>
                            </div>
                        </div>

                        <ul class="stat-list">
                            @foreach (var row in Model.StatRows)
                            {
                                <li class="stat-row @(row.Muted ? "stat-row--muted" : "")">
                                    <div class="stat-row__values"><span class="stat-val @(row.HomeLeads ? "is-lead" : "")">@row.HomeText</span><span class="stat-row__label">@row.Label</span><span class="stat-val stat-val--away @(row.AwayLeads ? "is-lead" : "")">@row.AwayText</span></div>
                                    <div class="stat-bar" aria-hidden="true"><span class="bar-home" style="--w:@row.HomeWidth"></span><span class="bar-away" style="--w:@row.AwayWidth"></span></div>
                                </li>
                            }
                        </ul>
                    </section>
                }

                <!--  _MatchInfoCard  -->
                <section class="panel" aria-labelledby="info-title">
                    <div class="panel__head"><h2 class="panel__title" id="info-title">Maç bilgileri</h2></div>
                    <dl class="info-list">
                        <div><dt>Lig</dt><dd>@Model.LeagueName</dd></div>
                        <div><dt>Sezon</dt><dd>@Model.Season</dd></div>
                        <div><dt>Hafta</dt><dd>@m.Week</dd></div>
                        <div><dt>Stadyum</dt><dd>@m.Stadium</dd></div>
                        <div><dt>Şehir</dt><dd>@Model.CityText</dd></div>
                        <div><dt>Hakem</dt><dd>@Model.RefereeText</dd></div>
                        <div><dt>Seyirci</dt><dd>@Model.AttendanceText</dd></div>
                        <div><dt>Tarih</dt><dd>@Model.DateText</dd></div>
                        <div><dt>Saat</dt><dd>@Model.TimeText</dd></div>
                    </dl>
                </section>
            </aside>
        </div>
    </div>

    <p class="page-note">Sayfadaki veriler demo amaçlıdır.</p>
</main>

@section Scripts {
    <script src="~/js/match-detail.js" asp-append-version="true"></script>
}
