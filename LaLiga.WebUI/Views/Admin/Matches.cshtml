@model AdminMatchesPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Maç Yönetimi | La Liga Admin";
    ViewData["TopbarTitle"] = "Maç Yönetimi";
    ViewData["Breadcrumb"] = "Yönetim / Maçlar";
    ViewData["ActiveNav"] = "Matches";
}

<div class="page-head">
    <div>
        <span class="page-eyebrow">La Liga 2026/27</span>
        <h1 class="page-title">Maç Yönetimi</h1>
        <p class="page-desc">La Liga karşılaşmalarını görüntüleyebilir, ekleyebilir, düzenleyebilir ve silebilirsiniz.</p>
    </div>
    <button type="button" class="btn-a btn-a--primary" data-open-create>
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Yeni Maç Ekle
    </button>
</div>

<!--  _MatchTable (filtre + tablo)  -->
<section class="card-a" aria-label="Maç listesi">
    <form class="filter-bar" method="get" asp-action="Matches" role="search">
        <div class="filter-search">
            <label class="field-label" for="f-team">Takım Ara</label>
            <div class="input-icon">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <input class="input-a" id="f-team" name="team" type="search" placeholder="Takım adı yazın" autocomplete="off" value="@Model.FilterTeam">
            </div>
        </div>
        <div>
            <label class="field-label" for="f-week">Hafta Seç</label>
            <select class="select-a" id="f-week" name="week">
                <option value="">Tüm Haftalar</option>
                @foreach (var w in Model.WeekOptions)
                {
                    <option value="@w" selected="@(w == Model.FilterWeek)">@w. Hafta</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label" for="f-status">Durum</label>
            <select class="select-a" id="f-status" name="status">
                <option value="">Tümü</option>
                @foreach (var opt in AdminMatchesPageViewModel.StatusOptions)
                {
                    <option value="@opt.Value" selected="@(opt.Value == Model.FilterStatus)">@opt.Label</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <a class="btn-a btn-a--ghost" href="/Admin/Matches">Temizle</a>
            <button type="submit" class="btn-a btn-a--secondary">Filtrele</button>
        </div>
    </form>

    <div class="table-scroll">
        <table class="match-table">
            <caption class="visually-hidden">La Liga maç listesi</caption>
            <thead>
                <tr>
                    <th scope="col" class="col-id">ID</th>
                    <th scope="col">Hafta</th>
                    <th scope="col">Tarih</th>
                    <th scope="col">Saat</th>
                    <th scope="col">Ev Sahibi</th>
                    <th scope="col" class="col-score">Skor</th>
                    <th scope="col">Deplasman</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="col-actions">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Empty)
                {
                    <tr class="table-empty">
                        <td colspan="9"><strong>Kayıt bulunamadı</strong>Filtreleri değiştirin ya da Temizle ile tüm maçları gösterin.</td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model.Matches)
                    {
                        var home = Model.HomeCrest(m);
                        var away = Model.AwayCrest(m);

                        <tr data-id="@m.Id" data-week="@m.Week" data-home-id="@m.HomeTeamId" data-home-name="@m.HomeTeamName"
                            data-away-id="@m.AwayTeamId" data-away-name="@m.AwayTeamName" data-date="@Model.IsoDate(m)" data-time="@Model.IsoTime(m)"
                            data-stadium="@m.Stadium" data-status="@m.Status" data-home-score="@m.HomeScore" data-away-score="@m.AwayScore"
                            data-minute="@m.Minute" data-note="@m.Note" data-referee="@m.Referee" data-attendance="@m.Attendance">
                            <td class="col-id"><span>@m.Id</span></td>
                            <td class="week-cell">@m.Week. Hafta</td>
                            <td>@Model.DateText(m)</td>
                            <td>@Model.TimeText(m)</td>
                            <td><span class="team"><partial name="_TeamCrest" model="home" />@m.HomeTeamName</span></td>
                            <td class="col-score">
                                @if (Model.HasScore(m))
                                {
                                    <span class="score">@m.HomeScore - @m.AwayScore</span>
                                }
                                else
                                {
                                    <span class="score score--empty">-</span>
                                }
                            </td>
                            <td><span class="team"><partial name="_TeamCrest" model="away" />@m.AwayTeamName</span></td>
                            <td><span class="badge-a badge-a--@m.Status">@Model.StatusLabel(m.Status)</span></td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a class="act-btn" href="/Match/Detail/@m.Id" title="Detay" aria-label="Detay: @m.HomeTeamName - @m.AwayTeamName"><svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg></a>
                                    <button type="button" class="act-btn" data-edit="@m.Id" title="Düzenle" aria-label="Düzenle: @m.HomeTeamName - @m.AwayTeamName"><svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg></button>
                                    <button type="button" class="act-btn act-btn--danger" data-delete="@m.Id" title="Sil" aria-label="Sil: @m.HomeTeamName - @m.AwayTeamName"><svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="table-foot">
        <span>@Model.FooterText</span>
        <span>Sezon 2026/27</span>
    </div>
</section>

<dialog class="modal-a" id="match-modal" aria-labelledby="match-modal-title">
    <form data-match-form novalidate>
        <div class="modal-head">
            <h2 class="modal-title" id="match-modal-title">Yeni Maç Ekle</h2>
            <button type="button" class="icon-btn" data-modal-close aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>
        <div class="modal-body">
            <div class="form-alert" data-form-alert role="alert">Lütfen işaretli alanları kontrol edin.</div>
            <input type="hidden" name="id">
            <input type="hidden" name="minute">
            <input type="hidden" name="note">
            <input type="hidden" name="referee">
            <input type="hidden" name="attendance">
            <div class="form-grid">
                <div class="form-field" data-field="week">
                    <label class="field-label" for="m-week">Hafta <span class="req">*</span></label>
                    <select class="select-a" id="m-week" name="week" aria-describedby="m-week-err">
                        <option value="">Hafta seçin</option>
                        @foreach (var w in Model.WeekOptions)
                        {
                            <option value="@w">@w. Hafta</option>
                        }
                    </select>
                    <p class="field-error" id="m-week-err"></p>
                </div>
                <div class="form-field" data-field="status">
                    <label class="field-label" for="m-status">Maç Durumu</label>
                    <select class="select-a" id="m-status" name="status">
                        @foreach (var opt in AdminMatchesPageViewModel.StatusOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == MatchStatus.NotStarted)">@opt.Label</option>
                        }
                    </select>
                </div>
                <div class="form-field" data-field="home">
                    <label class="field-label" for="m-home">Ev Sahibi Takım <span class="req">*</span></label>
                    <select class="select-a" id="m-home" name="home" aria-describedby="m-home-err">
                        <option value="">Takım seçin</option>
                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id" data-stadium="@t.Stadium">@t.Name@(t.IsActive ? "" : " (Pasif)")</option>
                        }
                    </select>
                    <p class="field-error" id="m-home-err"></p>
                </div>
                <div class="form-field" data-field="away">
                    <label class="field-label" for="m-away">Deplasman Takımı <span class="req">*</span></label>
                    <select class="select-a" id="m-away" name="away" aria-describedby="m-away-err">
                        <option value="">Takım seçin</option>
                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id">@t.Name@(t.IsActive ? "" : " (Pasif)")</option>
                        }
                    </select>
                    <p class="field-error" id="m-away-err"></p>
                </div>
                <div class="form-field" data-field="date">
                    <label class="field-label" for="m-date">Maç Tarihi <span class="req">*</span></label>
                    <input class="input-a" id="m-date" name="date" type="date" aria-describedby="m-date-err">
                    <p class="field-error" id="m-date-err"></p>
                </div>
                <div class="form-field" data-field="time">
                    <label class="field-label" for="m-time">Maç Saati <span class="req">*</span></label>
                    <input class="input-a" id="m-time" name="time" type="time" aria-describedby="m-time-err">
                    <p class="field-error" id="m-time-err"></p>
                </div>
                <div class="form-field span-2" data-field="stadium">
                    <label class="field-label" for="m-stadium">Stadyum</label>
                    <input class="input-a" id="m-stadium" name="stadium" type="text" placeholder="Ev sahibi seçilince otomatik dolar">
                </div>
                <div class="score-fields span-2" data-score-fields hidden>
                    <div class="form-field" data-field="homeScore">
                        <label class="field-label" for="m-hs">Ev sahibi skoru <span class="req">*</span></label>
                        <input class="input-a" id="m-hs" name="homeScore" type="number" min="0" max="20" inputmode="numeric" aria-describedby="m-hs-err">
                        <p class="field-error" id="m-hs-err"></p>
                    </div>
                    <div class="form-field" data-field="awayScore">
                        <label class="field-label" for="m-as">Deplasman skoru <span class="req">*</span></label>
                        <input class="input-a" id="m-as" name="awayScore" type="number" min="0" max="20" inputmode="numeric" aria-describedby="m-as-err">
                        <p class="field-error" id="m-as-err"></p>
                    </div>
                </div>
            </div>
            <p class="field-hint" style="margin:14px 0 12px">Canlı veya Tamamlandı seçildiğinde skor alanları açılır.</p>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn-a btn-a--secondary" data-modal-close>Vazgeç</button>
            <button type="submit" class="btn-a btn-a--primary" data-submit-label>Kaydet</button>
        </div>
    </form>
</dialog>

<!-- Silme onayı -->
<dialog class="modal-a modal-a--sm" id="delete-modal" aria-labelledby="delete-modal-title">
    <form method="dialog">
        <div class="modal-head">
            <h2 class="modal-title" id="delete-modal-title">Maçı sil</h2>
            <button type="submit" value="cancel" class="icon-btn" aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>
        <div class="modal-body">
            <p class="confirm-text" data-delete-text></p>
        </div>
        <div class="modal-foot">
            <button type="submit" value="cancel" class="btn-a btn-a--secondary">Vazgeç</button>
            <button type="submit" value="confirm" class="btn-a btn-a--danger">Evet, sil</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/admin-matches.js" asp-append-version="true"></script>
}
