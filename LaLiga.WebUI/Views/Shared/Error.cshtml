@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<main class="container py-5" style="max-width: 640px;">
    <h1 class="h4 text-danger">Bir hata oluştu</h1>
    <p>İsteğiniz işlenirken beklenmeyen bir sorun çıktı. Lütfen daha sonra tekrar deneyin.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">İstek kimliği: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" href="/">Ana sayfaya dön</a>
</main>
